VERSION 5.00
Begin {9EB8768B-CDFA-44DF-8F3E-857A8405E1DB} RDA020_借入一覧表_全件 
   Caption         =   "借入一覧表"
   ClientHeight    =   6765
   ClientLeft      =   60
   ClientTop       =   345
   ClientWidth     =   10380
   Icon            =   "RDA020_借入一覧表_全件.dsx":0000
   StartUpPosition =   2  '画面の中央
   WindowState     =   2  '最大化
   _ExtentX        =   18309
   _ExtentY        =   11933
   SectionData     =   "RDA020_借入一覧表_全件.dsx":0ECA
