'
    'FBA010_帳票範囲指定.メッセージ = "出力できませんでした"
    'FBA010_帳票範囲指定.メッセージ.Refresh
    GSstrt帳票Msg = "出力できませんでした"
'
    Me.Cancel
    DoEvents

    ' =========================================
    '           　 ボタン制御
    ' =========================================
    'FBA010_帳票範囲指定.実行.Enabled = True
    'FBA010_帳票範囲指定.閉じる.Enabled = True
'
    'FBA010_帳票範囲指定.拡張.SetFocus
'
    Unload Me
'
End Sub

'------------------------------------------------
' Detail_BeforePrint
'------------------------------------------------
Private Sub Detail_BeforePrint()
'
    Call MXA030_ReportColor(Me.Detail.Controls("I_融資金額"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_当期融資残高"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_来前期融資残高"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_来期融資残高"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_1年内返済額"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_追加計上額"))
    
    Me.Detail.Controls("I_融資金額") = Format(P8.FCDblRD(Me.Detail.Controls("I_融資金額")) / w分母, "#,##0")
    Me.Detail.Controls("I_当期融資残高") = Format(P8.FCDblRD(Me.Detail.Controls("I_当期融資残高")) / w分母, "#,##0")
    Me.Detail.Controls("I_来前期融資残高") = Format(P8.FCDblRD(Me.Detail.Controls("I_来前期融資残高")) / w分母, "#,##0")
    Me.Detail.Controls("I_来期融資残高") = Format(P8.FCDblRD(Me.Detail.Controls("I_来期融資残高")) / w分母, "#,##0")
    Me.Detail.Controls("I_1年内返済額") = Format(P8.FCDblRD(Me.Detail.Controls("I_1年内返済額")) / w分母, "#,##0")
    Me.Detail.Controls("I_追加計上額") = Format(P8.FCDblRD(Me.Detail.Controls("I_追加計上額")) / w分母, "#,##0")
End Sub

'------------------------------------------------
' GroupFooter1_BeforePrint
'------------------------------------------------
Private Sub GroupFooter1_BeforePrint()
'
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_融資金額"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_当期融資残高"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_来前期融資残高"))
