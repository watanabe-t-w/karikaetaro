'
End Sub

'------------------------------------------------
' Detail_BeforePrint
'------------------------------------------------
Private Sub Detail_BeforePrint()
'
    Dim wiKubun As Integer
    
    Dim wd01 As Double
    Dim Yusi As Double, Zan As Double
    Dim Hzan As Double, RHeizan As Double
    Dim Nisu As Double, Risoku As Double

    Dim wsKubun As String
    Dim wism As Integer
'
    Yusi = 0: Zan = 0
    Hzan = 0: RHeizan = 0
    Nisu = 0: Risoku = 0
'
    wism = P8.FCDbl(Me.Detail.Controls("I_SM区分"))
    
    Me.Detail.Controls("I_SM区分") = ""
    If wism = 1 And P8.FCStr(Me.Detail.Controls("I_金融リストラ番号")) <> "" Then
        Me.Detail.Controls("I_SM区分") = "借入SM"
    ElseIf wism = 0 And P8.FCStr(Me.Detail.Controls("I_金融解約年月日")) <> "" Then
        Me.Detail.Controls("I_SM区分") = "解約SM"
    End If
'
    wsKubun = P8.FCStr(Me.Detail.Controls("I_集計区分"))
    If GRpt.集計 = "金利種別計" Then
    '金利種別
        If wsKubun = "変動" Then
            wiKubun = 0
        Else
            wiKubun = 1
        End If
    ElseIf GRpt.集計 = "担保区分計" Then
    '担保区分
        If wsKubun = "有担" Then
            wiKubun = 0
        Else
            wiKubun = 1
        End If
    ElseIf GRpt.集計 = "長短区分計" Then
    '長短区分
        If wsKubun = "長期" Then
            wiKubun = 0
        Else
            wiKubun = 1
        End If
    End If
'
    Yusi = P8.FCDbl(Me.Detail.Controls("I_融資金額"))
    Zan = P8.FCDbl(Me.Detail.Controls("I_融資残高"))
    Nisu = P8.FCDbl(Me.Detail.Controls("I_平均残高日数"))
    Hzan = P8.FCDbl(Me.Detail.Controls("I_平均残高"))
    RHeizan = P8.FCDbl(Me.Detail.Controls("I_利息計算平均残高"))
    Risoku = P8.FCDbl(Me.Detail.Controls("I_平均利息基礎額"))
'
    Me.Detail.Controls("I_融資金額") = Format(P8.FCDbl(Me.Detail.Controls("I_融資金額") / w分母), "#,##0")
    Me.Detail.Controls("I_融資残高") = Format(P8.FCDbl(Zan / w分母), "#,##0")
    
    Me.Detail.Controls("I_平均残高日数") = Format(Nisu, "#,##0")
    
    wd01 = P8.FRound(P8.FCDiv(Hzan, Nisu), 0)
    Me.Detail.Controls("I_平均残高") = Format(wd01 / w分母, "#,##0")
    
    wd01 = P8.FRound(P8.FCDiv(RHeizan, Nisu), 0)
    Me.Detail.Controls("I_利息計算平均残高") = Format(wd01 / w分母, "#,##0")
    
    Me.Detail.Controls("I_平均利息基礎額") = Format(Risoku / w分母, "#,##0")
    
    Me.Detail.Controls("I_平均金利") = Format(Round(P8.FCDiv(Risoku * 365 / Nisu, wd01) * 100, 6), "#,##0.00000")
    
    GrCnt1(wiKubun) = GrCnt1(wiKubun) + 1
    Yusi1(wiKubun) = Yusi1(wiKubun) + Yusi
    Zan1(wiKubun) = Zan1(wiKubun) + Zan
    Hzan1(wiKubun) = Hzan1(wiKubun) + Hzan
    RHeizan1(wiKubun) = RHeizan1(wiKubun) + RHeizan
    Risoku1(wiKubun) = Risoku1(wiKubun) + Risoku
   
    GrCnt2(wiKubun) = GrCnt2(wiKubun) + 1
    Yusi2(wiKubun) = Yusi2(wiKubun) + Yusi
    Zan2(wiKubun) = Zan2(wiKubun) + Zan
    Hzan2(wiKubun) = Hzan2(wiKubun) + Hzan
    RHeizan2(wiKubun) = RHeizan2(wiKubun) + RHeizan
    Risoku2(wiKubun) = Risoku2(wiKubun) + Risoku
    
    GrCnt3(wiKubun) = GrCnt3(wiKubun) + 1
    Yusi3(wiKubun) = Yusi3(wiKubun) + Yusi
    Zan3(wiKubun) = Zan3(wiKubun) + Zan
    Hzan3(wiKubun) = Hzan3(wiKubun) + Hzan
    RHeizan3(wiKubun) = RHeizan3(wiKubun) + RHeizan
    Risoku3(wiKubun) = Risoku3(wiKubun) + Risoku
    
    GrCnt4(wiKubun) = GrCnt4(wiKubun) + 1
    Yusi4(wiKubun) = Yusi4(wiKubun) + Yusi
    Zan4(wiKubun) = Zan4(wiKubun) + Zan
    Hzan4(wiKubun) = Hzan4(wiKubun) + Hzan
    RHeizan4(wiKubun) = RHeizan4(wiKubun) + RHeizan
    Risoku4(wiKubun) = Risoku4(wiKubun) + Risoku
    
    GrCntT(wiKubun) = GrCntT(wiKubun) + 1
    YusiT(wiKubun) = YusiT(wiKubun) + Yusi
    ZanT(wiKubun) = ZanT(wiKubun) + Zan
    HzanT(wiKubun) = HzanT(wiKubun) + Hzan
    RHeizanT(wiKubun) = RHeizanT(wiKubun) + RHeizan
    RisokuT(wiKubun) = RisokuT(wiKubun) + Risoku

    G_Nisu = Nisu
'
End Sub

'------------------------------------------------
' GroupFooter1_BeforePrint
'------------------------------------------------
Private Sub GroupFooter1_BeforePrint()
'
    Dim wd01 As Double
    Dim Hzan As Double, RHeizan As Double, Risoku As Double
'
    Hzan = P8.FCDbl(Me.GroupFooter1.Controls("G10_平均残高"))
    RHeizan = P8.FCDbl(Me.GroupFooter1.Controls("G10_利息計算平均残高"))
    Risoku = P8.FCDbl(Me.GroupFooter1.Controls("G10_平均利息基礎額"))
'
    Me.GroupFooter1.Controls("G10_融資金額") = Format(P8.FCDbl(Me.GroupFooter1.Controls("G10_融資金額") / w分母), "#,##0")
    Me.GroupFooter1.Controls("G11_融資金額") = Format(Yusi1(0) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G12_融資金額") = Format(Yusi1(1) / w分母, "#,##0")
    
    Me.GroupFooter1.Controls("G10_融資残高") = Format(P8.FCDbl(Me.GroupFooter1.Controls("G10_融資残高") / w分母), "#,##0")
    Me.GroupFooter1.Controls("G11_融資残高") = Format(Zan1(0) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G12_融資残高") = Format(Zan1(1) / w分母, "#,##0")
'
    Me.GroupFooter1.Controls("G10_平均残高日数") = Format(G_Nisu, "#,##0")
    Me.GroupFooter1.Controls("G11_平均残高日数") = Format(G_Nisu, "#,##0")
    Me.GroupFooter1.Controls("G12_平均残高日数") = Format(G_Nisu, "#,##0")
    
    wd01 = P8.FRound(P8.FCDiv(Hzan, G_Nisu), 0)
    Me.GroupFooter1.Controls("G10_平均残高") = Format(wd01 / w分母, "#,##0")
    wd01 = P8.FRound(P8.FCDiv(Hzan1(0), G_Nisu), 0)
    Me.GroupFooter1.Controls("G11_平均残高") = Format(wd01 / w分母, "#,##0")
    wd01 = P8.FRound(P8.FCDiv(Hzan1(1), G_Nisu), 0)
    Me.GroupFooter1.Controls("G12_平均残高") = Format(wd01 / w分母, "#,##0")
    
    wd01 = P8.FRound(P8.FCDiv(RHeizan, G_Nisu), 0)
    Me.GroupFooter1.Controls("G10_利息計算平均残高") = Format(wd01 / w分母, "#,##0")
    wd01 = P8.FRound(P8.FCDiv(RHeizan1(0), G_Nisu), 0)
    Me.GroupFooter1.Controls("G11_利息計算平均残高") = Format(wd01 / w分母, "#,##0")
    wd01 = P8.FRound(P8.FCDiv(RHeizan1(1), G_Nisu), 0)
    Me.GroupFooter1.Controls("G12_利息計算平均残高") = Format(wd01 / w分母, "#,##0")
    
    Me.GroupFooter1.Controls("G10_平均利息基礎額") = Format(Risoku / w分母, "#,##0")
    Me.GroupFooter1.Controls("G11_平均利息基礎額") = Format(Risoku1(0) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G12_平均利息基礎額") = Format(Risoku1(1) / w分母, "#,##0")

    wd01 = P8.FRound(P8.FCDiv(RHeizan, G_Nisu), 0)
    Me.GroupFooter1.Controls("G10_平均金利") = Format(Round(P8.FCDiv(Risoku * 365 / G_Nisu, wd01) * 100, 6), "#,##0.00000")
    wd01 = P8.FRound(P8.FCDiv(RHeizan1(0), G_Nisu), 0)
    Me.GroupFooter1.Controls("G11_平均金利") = Format(Round(P8.FCDiv(Risoku1(0) * 365 / G_Nisu, wd01) * 100, 6), "#,##0.00000")
    wd01 = P8.FRound(P8.FCDiv(RHeizan1(1), G_Nisu), 0)
    Me.GroupFooter1.Controls("G12_平均金利") = Format(Round(P8.FCDiv(Risoku1(1) * 365 / G_Nisu, wd01) * 100, 6), "#,##0.00000")
'
    Me.GroupFooter1.Controls("G11_件数") = Format(P8.FCDbl(GrCnt1(0)), "#,##0")
    Me.GroupFooter1.Controls("G12_件数") = Format(P8.FCDbl(GrCnt1(1)), "#,##0")
'
End Sub

'------------------------------------------------
' GroupFooter1_AfterPrint
'------------------------------------------------
Private Sub GroupFooter1_AfterPrint()
'
    Dim j As Integer
'
    For j = 0 To 1
        GrCnt1(j) = 0
        Yusi1(j) = 0: Zan1(j) = 0
        Hzan1(j) = 0: RHeizan1(j) = 0: Risoku1(j) = 0
    Next j
'
End Sub

'------------------------------------------------
' GroupFooter2_BeforePrint
'------------------------------------------------
Private Sub GroupFooter2_BeforePrint()
'
    Dim wd01 As Double
    Dim Hzan As Double, RHeizan As Double, Risoku As Double
'
    Hzan = P8.FCDbl(Me.GroupFooter2.Controls("G20_平均残高"))
    RHeizan = P8.FCDbl(Me.GroupFooter2.Controls("G20_利息計算平均残高"))
    Risoku = P8.FCDbl(Me.GroupFooter2.Controls("G20_平均利息基礎額"))
'
