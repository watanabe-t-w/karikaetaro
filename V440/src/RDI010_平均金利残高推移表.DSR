Private Sub GroupFooter1_AfterPrint()
'
    Dim j As Integer, k As Integer
'
    For j = 0 To 1
        G1_Cnt(j) = 0
            
        For k = 0 To wML
            G1_Zan(j, k) = 0
            G1_Hzan(j, k) = 0
            G1_RHeizan(j, k) = 0
            'G1_Nisu(j, k) = 0
