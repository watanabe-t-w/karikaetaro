        Me.GroupFooter4.Controls("G42_" + wstr) = Format(G4_Zan(1, j) / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(5)
        Me.GroupFooter4.Controls("G40_" + wstr) = Format(G_Nisu(j), "#,##0")
        Me.GroupFooter4.Controls("G41_" + wstr) = Format(G_Nisu(j), "#,##0")
        Me.GroupFooter4.Controls("G42_" + wstr) = Format(G_Nisu(j), "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(3)
        Hzan(j) = P8.FCDbl(Me.GroupFooter4.Controls("G40_" + wstr)) '平均残高
        wd01 = P8.FRound(P8.FCDiv(Hzan(j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G40_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G4_Hzan(0, j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G41_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G4_Hzan(1, j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G42_" + wstr) = Format(wd01 / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(4)
        RHeizan(j) = P8.FCDbl(Me.GroupFooter4.Controls("G40_" + wstr)) '利息計算平均残高
        wd01 = P8.FRound(P8.FCDiv(RHeizan(j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G40_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G4_RHeizan(0, j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G41_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G4_RHeizan(1, j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G42_" + wstr) = Format(wd01 / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(6)
        Risoku(j) = P8.FCDbl(Me.GroupFooter4.Controls("G40_" + wstr)) '平均利息基礎額
        Me.GroupFooter4.Controls("G40_" + wstr) = Format(Risoku(j) / w分母, "#,##0")
        Me.GroupFooter4.Controls("G41_" + wstr) = Format(P8.FCDblRD(G4_Risoku(0, j) / w分母), "#,##0")
        Me.GroupFooter4.Controls("G42_" + wstr) = Format(P8.FCDblRD(G4_Risoku(1, j) / w分母), "#,##0")

        '平均金利
        wstr = Right("00" + CStr(j), 2) + CStr(2)
        wd01 = P8.FRound(P8.FCDiv(RHeizan(j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G40_" + wstr) = Format(Round(P8.FCDiv(Risoku(j) * 365 / G_Nisu(j), wd01) * 100, 6), "#,##0.00000")
        wd01 = P8.FRound(P8.FCDiv(G4_RHeizan(0, j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G41_" + wstr) = Format(Round(P8.FCDiv(G4_Risoku(0, j) * 365 / G_Nisu(j), wd01) * 100, 6), "#,##0.00000")
        wd01 = P8.FRound(P8.FCDiv(G4_RHeizan(1, j), G_Nisu(j)), 0)
        Me.GroupFooter4.Controls("G42_" + wstr) = Format(Round(P8.FCDiv(G4_Risoku(1, j) * 365 / G_Nisu(j), wd01) * 100, 6), "#,##0.00000")
    Next j
