'------------------------------------------------
' RDB020_コントロールセット
'------------------------------------------------
Private Sub RDB020_コントロールセット()
    Dim j As Integer
'
    For j = 1 To wML
        w番号 = Right("00" + CStr(j), 2)
        Me.PageHeader.Controls("Lbl_" + w番号 + "番目年月") = w推移表タイトル.X番目年月(j)
    Next
'
End Sub

'------------------------------------------------
' Detail_BeforePrint
'------------------------------------------------
Private Sub Detail_BeforePrint()
'
    Dim j As Integer, k As Integer, wiKubun As Integer
    Dim wstr As String, wsKubun As String
    Dim wi_Cnt As Integer
    Dim wism As Integer
    Dim wd01 As Double
    Dim Zan(10) As Double, Hzan(10) As Double, RHeizan(10) As Double
    Dim Nisu(10) As Double, Risoku(10) As Double
'
    wsKubun = P8.FCStr(Me.Detail.Controls("I_集計区分"))
    If GRpt.集計 = "金利種別計" Then
    '金利種別
        If wsKubun = "変動" Then
            wiKubun = 0
        Else
            wiKubun = 1
        End If
    ElseIf GRpt.集計 = "担保区分計" Then
    '担保区分
        If wsKubun = "有担" Then
            wiKubun = 0
        Else
            wiKubun = 1
        End If
    ElseIf GRpt.集計 = "長短区分計" Then
    '長短区分
        If wsKubun = "長期" Then
            wiKubun = 0
        Else
            wiKubun = 1
        End If
    End If
'
    For j = 0 To wML
        wstr = Right("00" + CStr(j), 2) + CStr(1)
        Zan(j) = P8.FCDbl(Me.Detail.Controls("I_" + wstr)) '融資残高
        Me.Detail.Controls("I_" + wstr) = Format(Zan(j) / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(5)
        Nisu(j) = P8.FCDbl(Me.Detail.Controls("I_" + wstr)) '平均残高日数
        Me.Detail.Controls("I_" + wstr) = Format(Nisu(j), "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(3)
        Hzan(j) = P8.FCDbl(Me.Detail.Controls("I_" + wstr)) '平均残高
        wd01 = P8.FRound(P8.FCDiv(Hzan(j), Nisu(j)), 0)
        Me.Detail.Controls("I_" + wstr) = Format(wd01 / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(4)
        RHeizan(j) = P8.FCDbl(Me.Detail.Controls("I_" + wstr)) '利息計算平均残高
        wd01 = P8.FRound(P8.FCDiv(RHeizan(j), Nisu(j)), 0)
        Me.Detail.Controls("I_" + wstr) = Format(wd01 / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(6)
        Risoku(j) = P8.FCDbl(Me.Detail.Controls("I_" + wstr)) '平均利息基礎額
        Me.Detail.Controls("I_" + wstr) = Format(Risoku(j) / w分母, "#,##0")

        '平均金利
        wstr = Right("00" + CStr(j), 2) + CStr(2)
        Me.Detail.Controls("I_" + wstr) = Format(Round(P8.FCDiv(Risoku(j) * 365 / Nisu(j), wd01) * 100, 6), "#,##0.00000")
    Next j
'
    'シミュレーション内容
    wism = P8.FCDbl(Me.Detail.Controls("I_SM区分"))
    
    Me.Detail.Controls("I_SM区分") = ""
    
    If wism = 1 And P8.FCStr(Me.Detail.Controls("I_金融リストラ番号")) <> "" Then
        Me.Detail.Controls("I_SM区分") = "借入ｼﾐｭﾚｰｼｮﾝ"
    ElseIf wism = 0 And P8.FCStr(Me.Detail.Controls("I_金融解約年月日")) <> "" Then
        Me.Detail.Controls("I_SM区分") = "解約ｼﾐｭﾚｰｼｮﾝ"
    End If
'
    G1_Cnt(wiKubun) = G1_Cnt(wiKubun) + 1
    G2_Cnt(wiKubun) = G2_Cnt(wiKubun) + 1
    G3_Cnt(wiKubun) = G3_Cnt(wiKubun) + 1
    G4_Cnt(wiKubun) = G4_Cnt(wiKubun) + 1
    GT_Cnt(wiKubun) = GT_Cnt(wiKubun) + 1
    
    For j = 0 To wML
        G1_Zan(wiKubun, j) = G1_Zan(wiKubun, j) + Zan(j)
        G1_Hzan(wiKubun, j) = G1_Hzan(wiKubun, j) + Hzan(j)
        G1_RHeizan(wiKubun, j) = G1_RHeizan(wiKubun, j) + RHeizan(j)
        G1_Risoku(wiKubun, j) = G1_Risoku(wiKubun, j) + Risoku(j)
        
        G2_Zan(wiKubun, j) = G2_Zan(wiKubun, j) + Zan(j)
        G2_Hzan(wiKubun, j) = G2_Hzan(wiKubun, j) + Hzan(j)
        G2_RHeizan(wiKubun, j) = G2_RHeizan(wiKubun, j) + RHeizan(j)
        G2_Risoku(wiKubun, j) = G2_Risoku(wiKubun, j) + Risoku(j)
        
        G3_Zan(wiKubun, j) = G3_Zan(wiKubun, j) + Zan(j)
        G3_Hzan(wiKubun, j) = G3_Hzan(wiKubun, j) + Hzan(j)
        G3_RHeizan(wiKubun, j) = G3_RHeizan(wiKubun, j) + RHeizan(j)
        G3_Risoku(wiKubun, j) = G3_Risoku(wiKubun, j) + Risoku(j)
        
        G4_Zan(wiKubun, j) = G4_Zan(wiKubun, j) + Zan(j)
        G4_Hzan(wiKubun, j) = G4_Hzan(wiKubun, j) + Hzan(j)
        G4_RHeizan(wiKubun, j) = G4_RHeizan(wiKubun, j) + RHeizan(j)
        G4_Risoku(wiKubun, j) = G4_Risoku(wiKubun, j) + Risoku(j)
        
        GT_Zan(wiKubun, j) = GT_Zan(wiKubun, j) + Zan(j)
        GT_Hzan(wiKubun, j) = GT_Hzan(wiKubun, j) + Hzan(j)
        GT_RHeizan(wiKubun, j) = GT_RHeizan(wiKubun, j) + RHeizan(j)
        GT_Risoku(wiKubun, j) = GT_Risoku(wiKubun, j) + Risoku(j)
    
        G_Nisu(j) = Nisu(j)
    Next j
'
End Sub

'------------------------------------------------
' GroupFooter1_BeforePrint
'------------------------------------------------
Private Sub GroupFooter1_BeforePrint()
'
    Dim j As Integer, k As Integer
    Dim wd01 As Double
    Dim Zan(10) As Double, Hzan(10) As Double, RHeizan(10) As Double, Risoku(10) As Double
'
    '計名
    wstr = Me.GroupFooter1.Controls("G10_計名")
    Me.GroupFooter1.Controls("G10_計名") = wstr & "　計"
    
    If GRpt.集計 = "金利種別計" Then
    '金利種別
        Me.GroupFooter1.Controls("G11_計名") = wstr & "　変動金利計"
        Me.GroupFooter1.Controls("G12_計名") = wstr & "　固定金利計"
    ElseIf GRpt.集計 = "担保区分計" Then
    '担保区分
        Me.GroupFooter1.Controls("G11_計名") = wstr & "　有担保計"
        Me.GroupFooter1.Controls("G12_計名") = wstr & "　無担保計"
    ElseIf GRpt.集計 = "長短区分計" Then
    '長短区分
        Me.GroupFooter1.Controls("G11_計名") = wstr & "　長期借入金計"
        Me.GroupFooter1.Controls("G12_計名") = wstr & "　短期借入金計"
    End If
'
    Me.GroupFooter1.Controls("G10_件数") = Format(P8.FCDbl(Me.GroupFooter1.Controls("G10_件数")), "#,##0")
    
    Me.GroupFooter1.Controls("G11_件数") = Format(G1_Cnt(0), "#,##0")
    Me.GroupFooter1.Controls("G12_件数") = Format(G1_Cnt(1), "#,##0")
    '
    For j = 0 To wML
        wstr = Right("00" + CStr(j), 2) + CStr(1)
        Zan(j) = P8.FCDbl(Me.GroupFooter1.Controls("G10_" + wstr)) '融資残高
        Me.GroupFooter1.Controls("G10_" + wstr) = Format(Zan(j) / w分母, "#,##0")
        Me.GroupFooter1.Controls("G11_" + wstr) = Format(G1_Zan(0, j) / w分母, "#,##0")
        Me.GroupFooter1.Controls("G12_" + wstr) = Format(G1_Zan(1, j) / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(5)
        Me.GroupFooter1.Controls("G10_" + wstr) = Format(G_Nisu(j), "#,##0")
        Me.GroupFooter1.Controls("G11_" + wstr) = Format(G_Nisu(j), "#,##0")
        Me.GroupFooter1.Controls("G12_" + wstr) = Format(G_Nisu(j), "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(3)
        Hzan(j) = P8.FCDbl(Me.GroupFooter1.Controls("G10_" + wstr)) '平均残高
        wd01 = P8.FRound(P8.FCDiv(Hzan(j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G10_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G1_Hzan(0, j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G11_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G1_Hzan(1, j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G12_" + wstr) = Format(wd01 / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(4)
        RHeizan(j) = P8.FCDbl(Me.GroupFooter1.Controls("G10_" + wstr)) '利息計算平均残高
        wd01 = P8.FRound(P8.FCDiv(RHeizan(j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G10_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G1_RHeizan(0, j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G11_" + wstr) = Format(wd01 / w分母, "#,##0")
        wd01 = P8.FRound(P8.FCDiv(G1_RHeizan(1, j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G12_" + wstr) = Format(wd01 / w分母, "#,##0")
        
        wstr = Right("00" + CStr(j), 2) + CStr(6)
        Risoku(j) = P8.FCDbl(Me.GroupFooter1.Controls("G10_" + wstr)) '平均利息基礎額
        Me.GroupFooter1.Controls("G10_" + wstr) = Format(Risoku(j) / w分母, "#,##0")
        Me.GroupFooter1.Controls("G11_" + wstr) = Format(P8.FCDblRD(G1_Risoku(0, j) / w分母), "#,##0")
        Me.GroupFooter1.Controls("G12_" + wstr) = Format(P8.FCDblRD(G1_Risoku(1, j) / w分母), "#,##0")

        '平均金利
        wstr = Right("00" + CStr(j), 2) + CStr(2)
        wd01 = P8.FRound(P8.FCDiv(RHeizan(j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G10_" + wstr) = Format(Round(P8.FCDiv(Risoku(j) * 365 / G_Nisu(j), wd01) * 100, 6), "#,##0.00000")
        wd01 = P8.FRound(P8.FCDiv(G1_RHeizan(0, j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G11_" + wstr) = Format(Round(P8.FCDiv(G1_Risoku(0, j) * 365 / G_Nisu(j), wd01) * 100, 6), "#,##0.00000")
        wd01 = P8.FRound(P8.FCDiv(G1_RHeizan(1, j), G_Nisu(j)), 0)
        Me.GroupFooter1.Controls("G12_" + wstr) = Format(Round(P8.FCDiv(G1_Risoku(1, j) * 365 / G_Nisu(j), wd01) * 100, 6), "#,##0.00000")
    Next j
'
End Sub

'------------------------------------------------
