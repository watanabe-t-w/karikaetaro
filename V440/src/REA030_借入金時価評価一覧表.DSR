' =========================================
'           　 帳票合成
' =========================================
'------------------------------------------------
' Report_Insert
'------------------------------------------------
Private Function Report_Insert() As Boolean
'
    Dim I As Integer, j As Integer
    Dim rpt(3) As Object
'
    Report_Insert = False
'
    For I = 0 To 3
        If I = 0 Then       '時価評価一覧表
            GRpt.作業 = "前期末"
            GRpt.帳票名 = "借入金時価評価一覧表_前期末"
            Set rpt(I) = New REA030_借入金時価評価一覧表_比較
        ElseIf I = 1 Then
            GRpt.作業 = "比較"
            GRpt.帳票名 = "借入金時価評価一覧表_増減"
            Set rpt(I) = New REA030_借入金時価評価一覧表_比較
        
        ElseIf I = 2 Then   '時価評価適用金利一覧
            GRpt.作業 = "決算日"
            GRpt.帳票名 = "借入金時価評価適用金利一覧"
            Set rpt(I) = New REA020_借入金時価評価適用金利一覧
        ElseIf I = 3 Then
            GRpt.作業 = "前期末"
            GRpt.帳票名 = "借入金時価評価適用金利一覧_前期末"
            Set rpt(I) = New REA020_借入金時価評価適用金利一覧
        End If
    
        If wRetRpt(I) = True Then
            rpt(I).Run False
          
            For j = 0 To rpt(I).Pages.Count - 1
                Me.Pages.Insert Me.Pages.Count, rpt(I).Pages(j)
            Next j
        
            Me.Pages.Commit
        
            Report_Insert = True
        End If
    Next I
'
End Function
