VERSION 5.00
Begin {9EB8768B-CDFA-44DF-8F3E-857A8405E1DB} REA030_借入金時価評価一覧表 
   Caption         =   "借入金時価評価一覧表"
   ClientHeight    =   7440
   ClientLeft      =   60
   ClientTop       =   345
   ClientWidth     =   12300
   Icon            =   "REA030_借入金時価評価一覧表.dsx":0000
   StartUpPosition =   2  '画面の中央
   WindowState     =   2  '最大化
   _ExtentX        =   21696
   _ExtentY        =   13123
   SectionData     =   "REA030_借入金時価評価一覧表.dsx":0ECA
End
Attribute VB_Name = "REA030_借入金時価評価一覧表"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
'
Private Const pPROGRAM_ID As String = "REA030_借入金時価評価一覧表"

Dim wstr As String
Dim wRs As Recordset

Dim w分母 As Integer
Dim wRetRpt(3) As Boolean

Dim wfmt年月 As String, wfmt年月日 As String
'
'------------------------------------------------
' ActiveReport_ReportStart
'------------------------------------------------
Private Sub ActiveReport_ReportStart()
'
    Dim wsTbl As String, wsS As String, ws01 As String
    
    Dim j As Integer
    Dim wOrder As String
    Dim FLG_Order As Boolean
'
    On Error GoTo ActiveReport_ReportStart_ERR
'
    '----------------------------------------------------------------
    '                         ** 初期設定 **
    '----------------------------------------------------------------
    'Connection
    Me.DataControl1.Connection = GDb
   
    '用紙セット
    Printer.PaperSize = vbPRPSA4
    Printer.Orientation = ddOLandscape
'
    If G基本情報.日付入力区分 = "0" Then
        '和暦入力
        wfmt年月 = "ee.mm"
        wfmt年月日 = "ee.mm.dd"
    Else
        wfmt年月 = "yy/mm"
        wfmt年月日 = "yy/mm/dd"
        '西暦入力
    End If
'
    ws01 = MAA200_サブタイトル作成()
    
    L_帳票名.Caption = " 借入金時価評価一覧表"
    L_帳票名.Caption = L_帳票名.Caption & "（" & ws01 & "）"
    
    GCsvName = "借入金時価評価一覧表"
    If G基本情報.日付入力区分 = "0" Then
    '和暦入力
        GCsvName = GCsvName & "_" & Format(G決算日(1), Gfmt年月) & "決算"
    Else
    '西暦入力
        GCsvName = GCsvName & "_" & Format(G決算日(1), "yyyymm") & "決算"
    End If
'
    '----------------------------------------------------------------
    '                           ** 見出し **
    '----------------------------------------------------------------
    出力日 = Now
    企業名 = GCoName
    
    If GRpt.千円単位 = 1 Then
        w分母 = 1000
        L_単位.Caption = "（千円単位）"
    Else
        w分母 = 1
        L_単位 = "（円単位）"
    End If
    
    '----------------------------------------------------------------
    '          ** グループ ・ Where ・ OrderＢｙ **
    '----------------------------------------------------------------
    'グループセット
    GroupHeader1.DataField = "GrpFld_KShubetu"
    GroupHeader2.DataField = "GrpFld_Ginko"
    
    wsS = "帳票指示: "
    '計名セット、Shapeカラー
    If GroupHeader1.DataField = "GrpFld_KShubetu" Then
        wsS = wsS & "分類1:基準金利区分 "
        Me.GroupFooter1.Controls("G10_番号").DataField = "I_基準金利区分"
        Me.GroupFooter1.Controls("G10_計名").DataField = "I_基準金利名"
        Me.GroupFooter1.Controls("Shape_1").BackColor = &HFFFFC0
    End If

    If GroupHeader2.DataField = "GrpFld_Ginko" Then
        wsS = wsS & "分類2:銀行 "
        Me.GroupFooter2.Controls("G20_番号").DataField = "I_銀行番号"
        Me.GroupFooter2.Controls("G20_計名").DataField = "I_銀行名"
        Me.GroupFooter2.Controls("Shape_2").BackColor = &HC0FFFF
    End If
    
    'ADD START 20170501 M.Mino
    If GRpt.コンボ_01 <> "" Then
        wsS = wsS & " 金利種別：" & GRpt.コンボ_01
    End If
    'ADD END 20170501 M.Mino
    
    '帳票指示
    Me.PageHeader.Controls("L_帳票指示").Caption = wsS
'
    GroupFooter1.Visible = True
    GroupFooter2.Visible = True
    If GroupHeader1.DataField = "" Then
        GroupFooter1.Visible = False
    End If
    If GroupHeader2.DataField = "" Then
        GroupFooter2.Visible = False
    End If
'
    '改ページ
    'Me.GroupFooter1.NewPage = GRpt.NewPage1
    'Me.GroupFooter2.NewPage = GRpt.NewPage2
'
    '----------------------------------------------------------------
    '                       ** 印字用ファイル作成 **
    '----------------------------------------------------------------
    '** 明細ファイル 削除 **
    wstr = ""
    wstr = wstr + "Delete * From DCDA010_借入金時価評価適用金利"
    GDb.Execute wstr
    
    wstr = ""
    wstr = wstr + "Delete * From DCDA010_借入金時価評価適用金利前期末"
    GDb.Execute wstr
    
    wstr = ""
    wstr = wstr + "Delete * From DCDA010_借入金時価評価"
    GDb.Execute wstr
    
    wstr = ""
    wstr = wstr + "Delete * From DCDA010_借入金時価評価前期末"
    GDb.Execute wstr
    
    wstr = ""
    wstr = wstr + "Delete * From DCDA010_借入金時価評価前期末比較増減"
    GDb.Execute wstr
'
    wRetRpt(0) = False: wRetRpt(1) = False
    wRetRpt(2) = False: wRetRpt(3) = False
    
    For j = 0 To UBound(G基準金利)
        '指定決算日、増減
        'GRet = MAA200_時価評価適用金利作成(G決算日(1), G基準金利(j).基準金利区分) DEL 20170501 M.Mino
        GRet = MAA200_時価評価適用金利作成(G決算日(1), G基準金利(j).基準金利区分, GRpt.コンボ_01)
        If GRet = True Then
            wRetRpt(2) = MAA200_時価評価適用金利
            'wRetRpt(1) = MAA200_時価評価一覧作成(G決算日(1), G決算日(0), G基準金利(j).基準金利区分, "") '指定決算日に増減フラグ判断 DEL 20170501 M.Mino
            wRetRpt(1) = MAA200_時価評価一覧作成(G決算日(1), G決算日(0), G基準金利(j).基準金利区分, "", GRpt.コンボ_01) '指定決算日に増減フラグ判断 ADD 20170501 M.Mino
        End If

        '前期末、増減
        'GRet = MAA200_時価評価適用金利作成(G決算日(0), G基準金利(j).基準金利区分) DEL 20170501 M.Mino
        GRet = MAA200_時価評価適用金利作成(G決算日(0), G基準金利(j).基準金利区分, GRpt.コンボ_01) 'ADD 20170501 M.Mino
        If GRet = True Then
            wRetRpt(3) = MAA200_時価評価適用金利("前期末")
            wRetRpt(0) = MAA200_時価評価一覧作成(G決算日(0), G決算日(0), G基準金利(j).基準金利区分, "前期末", GRpt.コンボ_01)
        End If
    
        '増減フラグ判断
        If wRetRpt(1) = True Or wRetRpt(0) = True Then
            wRetRpt(1) = True
        End If
    Next
'
    '----------------------------------------------------------------
    '                       ** レコード　ソース **
    '----------------------------------------------------------------
    wstr = "SELECT"
    
    'セクションGR
    wstr = wstr + " JZ.銀行番号 As GrpFld_Ginko"
    wstr = wstr + ",K.基準金利区分 As GrpFld_KShubetu"

    wstr = wstr + ",Format(JZ.決算年月日,'" & Gfmt年月日 & "') AS H00_決算日"
    wstr = wstr + ",JZ.借入番号 As I_借入番号"
    wstr = wstr + ",JZ.銀行番号 AS I_銀行番号"
    wstr = wstr + ",K.基準金利区分 As I_基準金利区分"
    wstr = wstr + ",S.基準金利名 As I_基準金利名"
    wstr = wstr + ",G.銀行名 As I_銀行名"
    wstr = wstr + ",Format(JZ.実行日,'" & wfmt年月日 & "') AS I_実行日"
    wstr = wstr + ",JZ.融資金額 AS I_融資金額"
    wstr = wstr + ",JZ.利率 AS I_利率"
    wstr = wstr + ",Format(JZ.最終返済実行日,'" & wfmt年月日 & "') AS I_最終返済実行日"
    wstr = wstr + ",JZ.決算年月日 AS I_決算年月日"
    wstr = wstr + ",JZ.合計決算時融資残高 AS I_期末残高"
    wstr = wstr + ",JZ.合計時価評価額 AS I_時価評価額"
    wstr = wstr + ",JZ.合計時価損益 AS I_時価評価損益"
    wstr = wstr + ",JZ.年以内返済予定元金 AS I_長期借入金2"
    wstr = wstr + ",JZ.年以内返済予定時価評価額 AS I_時価評価額2"
    wstr = wstr + ",JZ.年以内返済予定時価損益 AS I_時価評価損益2"
    wstr = wstr + ",JZ.年超返済予定元金 AS I_長期借入金3"
    wstr = wstr + ",JZ.年超返済予定時価評価額 AS I_時価評価額3"
    wstr = wstr + ",JZ.年超返済予定時価損益 AS I_時価評価損益3"

    wstr = wstr + " FROM ((DCDA010_借入金時価評価 AS JZ"
    wstr = wstr + " INNER JOIN DBDA010_借入金 As K"
    wstr = wstr + " ON JZ.借入番号 = K.借入番号)"
    wstr = wstr + " LEFT JOIN DAAA116_基準金利 As S"
    wstr = wstr + " ON K.基準金利区分 = S.基準金利区分)"
    wstr = wstr + " LEFT JOIN DAAA040_銀行マスタ As G"
    wstr = wstr + " ON K.銀行番号 = G.銀行番号"

    'wstr = wstr & " Order by K.借入金種別区分,K.銀行番号,K.借入番号"
    wstr = wstr & " Order by K.基準金利区分,K.銀行番号,K.実行日"
    
    Me.DataControl1.Source = wstr
'
    Exit Sub
'
'----------< ERROR ROUTINE >--------------------------------------------------------
ActiveReport_ReportStart_ERR:
    pERR_MES = pPROGRAM_ID + "/ ActiveReport_ReportStart() でエラー" + vbCrLf + vbCrLf + _
                "エラー番号　　：" + CStr(Err.Number) + vbCrLf + _
                "プロジェクト名：" + Err.Source + vbCrLf + _
                "エラー内容　　：" + Err.Description + vbCrLf + vbCrLf + _
                GProduct + "を終了します"
    pERR_RET = MsgBox(pERR_MES, vbOKOnly + vbCritical, pMSGBOX_TYTLE)
    pERR_RET = PUT_LOG(pERR_MES)

    End
'
End Sub

'------------------------------------------------
' ActiveReport_ReportEnd
'------------------------------------------------
Private Sub ActiveReport_ReportEnd()
'
    'FBA010_帳票範囲指定.メッセージ = ""
    'FBA010_帳票範囲指定.メッセージ.Refresh
'
    ' =========================================
    '           　 CsvFile 作成
    ' =========================================
    GRpt.作業 = ""
    GRpt.帳票名 = "借入金時価評価一覧表"
    If GRpt.CSV = 1 Then
        Call MX040_CsvOut_KARI
    End If
'
    ' =========================================
    '           　 ボタン制御
    ' =========================================
    'FBA010_帳票範囲指定.実行.Enabled = True
    'FBA010_帳票範囲指定.閉じる.Enabled = True
'
    'FBA010_帳票範囲指定.拡張.SetFocus
'
    ' =========================================
    '           　 帳票合成
    ' =========================================
    GRet = Report_Insert
'
    ' =========================================
    '  借換たろう！お試し版帳票出力回数チェック
    ' =========================================
    If GSys.Sys = "借入金 お試し版" Then
        Call MAA001_KARIKAETAROU_CNT
    End If
'
End Sub

'------------------------------------------------
' ActiveReport_NoData
'------------------------------------------------
Private Sub ActiveReport_NoData()
'
    'FBA010_帳票範囲指定.メッセージ = "出力すべきデータはありません"
    'FBA010_帳票範囲指定.メッセージ.Refresh
'
    ' =========================================
    '           　 帳票合成
    ' =========================================
    GRet = Report_Insert
    If GRet = False Then
        GSstrt帳票Msg = "出力すべきデータはありません"
    End If
'
    Me.Cancel
    DoEvents
'
    ' =========================================
    '           　 ボタン制御
    ' =========================================
    'FBA010_帳票範囲指定.実行.Enabled = True
    'FBA010_帳票範囲指定.閉じる.Enabled = True
'
    'FBA010_帳票範囲指定.拡張.SetFocus
'
    If GRet = False Then
        Unload Me
    End If
'
    ' =========================================
    '  借換たろう！お試し版帳票出力回数チェック
    ' =========================================
    If GSys.Sys = "借入金 お試し版" Then
        Call MAA001_KARIKAETAROU_CNT
    End If
'
End Sub

'------------------------------------------------
' ActiveReport_Error
'------------------------------------------------
Private Sub ActiveReport_Error(ByVal Number As Integer, ByVal Description As DDActiveReports2.IReturnString, ByVal Scode As Long, ByVal Source As String, ByVal HelpFile As String, ByVal HelpContext As Long, ByVal CancelDisplay As DDActiveReports2.IReturnBool)
'
    'FBA010_帳票範囲指定.メッセージ = "出力できませんでした"
    'FBA010_帳票範囲指定.メッセージ.Refresh
    GSstrt帳票Msg = "出力できませんでした"
'
    Me.Cancel
    DoEvents

    ' =========================================
    '           　 ボタン制御
    ' =========================================
    'FBA010_帳票範囲指定.実行.Enabled = True
    'FBA010_帳票範囲指定.閉じる.Enabled = True
'
    'FBA010_帳票範囲指定.拡張.SetFocus
'
    Unload Me
'
End Sub

'------------------------------------------------
' Detail_BeforePrint
'------------------------------------------------
Private Sub Detail_BeforePrint()
'
    Call MXA030_ReportColor(Me.Detail.Controls("I_融資金額"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_利率"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_期末残高"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_時価評価額"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_時価評価損益"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_長期借入金2"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_時価評価額2"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_時価評価損益2"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_長期借入金3"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_時価評価額3"))
    Call MXA030_ReportColor(Me.Detail.Controls("I_時価評価損益3"))
    
    Me.Detail.Controls("I_融資金額") = Format(P8.FCDblRD(Me.Detail.Controls("I_融資金額")) / w分母, "#,##0")
    Me.Detail.Controls("I_期末残高") = Format(P8.FCDblRD(Me.Detail.Controls("I_期末残高")) / w分母, "#,##0")
    Me.Detail.Controls("I_時価評価額") = Format(P8.FCDblRD(Me.Detail.Controls("I_時価評価額")) / w分母, "#,##0")
    Me.Detail.Controls("I_時価評価損益") = Format(P8.FCDblRD(Me.Detail.Controls("I_時価評価損益")) / w分母, "#,##0")
    Me.Detail.Controls("I_長期借入金2") = Format(P8.FCDblRD(Me.Detail.Controls("I_長期借入金2")) / w分母, "#,##0")
    Me.Detail.Controls("I_時価評価額2") = Format(P8.FCDblRD(Me.Detail.Controls("I_時価評価額2")) / w分母, "#,##0")
    Me.Detail.Controls("I_時価評価損益2") = Format(P8.FCDblRD(Me.Detail.Controls("I_時価評価損益2")) / w分母, "#,##0")
    Me.Detail.Controls("I_長期借入金3") = Format(P8.FCDblRD(Me.Detail.Controls("I_長期借入金3")) / w分母, "#,##0")
    Me.Detail.Controls("I_時価評価額3") = Format(P8.FCDblRD(Me.Detail.Controls("I_時価評価額3")) / w分母, "#,##0")
    Me.Detail.Controls("I_時価評価損益3") = Format(P8.FCDblRD(Me.Detail.Controls("I_時価評価損益3")) / w分母, "#,##0")
    Me.Detail.Controls("I_利率") = Format(P8.FCDblRD5(Me.Detail.Controls("I_利率")), "#,##0.00000")
'
End Sub

'------------------------------------------------
' GroupFooter1_BeforePrint
'------------------------------------------------
Private Sub GroupFooter1_BeforePrint()
'
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_期末残高"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_時価評価額"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_時価評価損益"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_長期借入金2"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_時価評価額2"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_時価評価損益2"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_長期借入金3"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_時価評価額3"))
    Call MXA030_ReportColor(Me.GroupFooter1.Controls("G10_時価評価損益3"))

    Me.GroupFooter1.Controls("G10_期末残高") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_期末残高")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_時価評価額") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_時価評価額")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_時価評価損益") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_時価評価損益")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_長期借入金2") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_長期借入金2")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_時価評価額2") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_時価評価額2")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_時価評価損益2") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_時価評価損益2")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_長期借入金3") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_長期借入金3")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_時価評価額3") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_時価評価額3")) / w分母, "#,##0")
    Me.GroupFooter1.Controls("G10_時価評価損益3") = Format(P8.FCDblRD(Me.GroupFooter1.Controls("G10_時価評価損益3")) / w分母, "#,##0")
'
End Sub

'------------------------------------------------
' GroupFooter2_BeforePrint
'------------------------------------------------
Private Sub GroupFooter2_BeforePrint()
'
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_期末残高"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_時価評価額"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_時価評価損益"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_長期借入金2"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_時価評価額2"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_時価評価損益2"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_長期借入金3"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_時価評価額3"))
    Call MXA030_ReportColor(Me.GroupFooter2.Controls("G20_時価評価損益3"))
    
    Me.GroupFooter2.Controls("G20_期末残高") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_期末残高")) / w分母, "#,##0")
    Me.GroupFooter2.Controls("G20_時価評価額") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_時価評価額")) / w分母, "#,##0")
    Me.GroupFooter2.Controls("G20_時価評価損益") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_時価評価損益")) / w分母, "#,##0")
    Me.GroupFooter2.Controls("G20_長期借入金2") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_長期借入金2")) / w分母, "#,##0")
    Me.GroupFooter2.Controls("G20_時価評価額2") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_時価評価額2")) / w分母, "#,##0")
    Me.GroupFooter2.Controls("G20_時価評価損益2") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_時価評価損益2")) / w分母, "#,##0")
    Me.GroupFooter2.Controls("G20_長期借入金3") = Format(P8.FCDblRD(Me.GroupFooter2.Controls("G20_長期借入金3")) / w分母, "#,##0")
