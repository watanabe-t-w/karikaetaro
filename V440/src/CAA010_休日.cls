'********************************************
Private Function CAA010_休日チェック(p年月日 As Date) As Boolean
'********************************************
    Dim j As Integer
    Dim wstr As String
    
    CAA010_休日チェック = False
 
    If Weekday(p年月日) = vbSunday _
    Or Weekday(p年月日) = vbSaturday Then
        CAA010_休日チェック = True
        Exit Function
    End If
        
    If CAA010_祝日チェック(p年月日) Then
        CAA010_休日チェック = True
        Exit Function
    Else
        If (Weekday(p年月日) = vbMonday) Then
            wstr = CStr(Month(p年月日)) + CStr(Day(p年月日))
            If wstr <> "14" Then   '１月３日は振替休日なし
                If CAA010_祝日チェック(p年月日 - 1) Then
                    '** 振替休日 **
                    CAA010_休日チェック = True
                    Exit Function
                End If
            End If
        End If
    End If
'
    For j = 1 To 4 '2
        If w祝日年月日1(j) = p年月日 Then
            CAA010_休日チェック = True
            Exit Function
        End If
    Next
    
    For j = 1 To 29 '28
        If w祝日年月日2(j) = p年月日 Then
            CAA010_休日チェック = True
            Exit Function
        End If
    Next
    
    For j = 1 To 16 '14
        If w祝日年月日3(j) = p年月日 Then
            CAA010_休日チェック = True
            Exit Function
        End If
    Next
'
End Function

'********************************************
Private Function CAA010_祝日チェック(p年月日 As Date) As Boolean
'********************************************
    Dim w月日 As String
    Dim j As Integer
    
    CAA010_祝日チェック = False
    
    w年月日 = p年月日
    
    w年 = CInt(Year(w年月日))
    w月 = CInt(Month(w年月日))
    w日 = CInt(Day(w年月日))
    
    w月日 = Right("00" + CStr(w月), 2) + Right("00" + CStr(w日), 2)

    For j = 1 To 12
        '2017/12/01 天皇誕生日 ADD
        If j = 11 And w年 > 2018 Then
            '処理しない
        Else
            If w金融休日固定日(j) = w月日 Then
                CAA010_祝日チェック = True
                Exit Function
            End If
        End If
    
    Next
    
    If CAA010_金融休日固定日2() Then
        CAA010_祝日チェック = True
        Exit Function
    End If

    '2017/12/01 天皇誕生日 ADD
    If CAA010_金融休日固定日3() Then
        CAA010_祝日チェック = True
        Exit Function
    End If
    
    If CAA010_成人_海_敬老_体育の日() Then
        CAA010_祝日チェック = True
        Exit Function
    End If

    If CAA010_春分秋分日() Then
        CAA010_祝日チェック = True
        Exit Function
    End If
End Function

'********************************************
Private Function CAA010_金融休日固定日2() As Boolean
'********************************************
    CAA010_金融休日固定日2 = False
        
    '** 山の日 **
    If w月 = 8 Then
        If w年 = 2020 Then  '2020年に限り8月10日    2018/09/01
            '** 10日 **
            If w日 = 10 Then
                CAA010_金融休日固定日2 = True
            End If
        ElseIf w年 = 2021 Then  '2021年に限り8月08日    2020/12/01
            '** 08日 **
            If w日 = 8 Then
                CAA010_金融休日固定日2 = True
            End If
        Else
            If w年 >= 2016 Then
                '** 11日 **
                If w日 = 11 Then
                    CAA010_金融休日固定日2 = True
                End If
            End If
        End If
    End If
    
End Function

'********************************************
Private Function CAA010_金融休日固定日3() As Boolean
'********************************************
    CAA010_金融休日固定日3 = False
        
    '** 天皇誕生日 **
    If w月 = 2 Then
        If w年 >= 2020 Then
            '** 23日 **
            If w日 = 23 Then
                CAA010_金融休日固定日3 = True
            End If
        End If
    End If
    
End Function

'********************************************
Private Function CAA010_成人_海_敬老_体育の日() As Boolean
'********************************************
    CAA010_成人_海_敬老_体育の日 = False
        
    '** 成人の日 **
    If w月 = 1 Then
        If w年 < 2000 Then
            '** 15日 **
            If w日 = 15 Then
                CAA010_成人_海_敬老_体育の日 = True
            End If
        Else
            '** 1月第2月曜 **
            If Weekday(w年月日) = vbMonday Then
                If ((w日 - 1) \ 7) = 1 Then
                    CAA010_成人_海_敬老_体育の日 = True
                End If
            End If
        End If
    End If
    
    '** 海の日 **
    If w月 = 7 Then
        If w年 = 2020 Then  '2020年に限り7月23日    2018/09/01
            '** 23日 **
            If w日 = 23 Then
                CAA010_成人_海_敬老_体育の日 = True
            End If
        ElseIf w年 = 2021 Then  '2021年に限り7月22日    2020/12/01
            '** 22日 **
            If w日 = 22 Then
                CAA010_成人_海_敬老_体育の日 = True
            End If
        Else
            If w年 < 2003 Then
                '** 20日 **
                If w日 = 20 Then
                    CAA010_成人_海_敬老_体育の日 = True
                End If
            Else
                '** 7月第3月曜日 **
                If Weekday(w年月日) = vbMonday Then
                    If ((w日 - 1) \ 7) = 2 Then
                        CAA010_成人_海_敬老_体育の日 = True
                    End If
                End If
            End If
        End If
    End If
    
    '** 敬老の日 **
    If w月 = 9 Then
        If w年 < 2003 Then
            '** 15日 **
            If w日 = 15 Then
                CAA010_成人_海_敬老_体育の日 = True
            End If
        Else
            '** 9月第3月曜日 **
            If Weekday(w年月日) = vbMonday Then
                If ((w日 - 1) \ 7) = 2 Then
                    CAA010_成人_海_敬老_体育の日 = True
                End If
            End If
        End If
    End If
    
    '** 体育の日 **
    If w月 = 10 Then
        If w年 = 2020 Then  '2020年に限り7月24日        2018/09/01
        ElseIf w年 = 2021 Then  '2021年に限り7月22日    2020/12/01
        Else
            If w年 < 2000 Then
                '** 10日 **
                If w日 = 10 Then
                    CAA010_成人_海_敬老_体育の日 = True
                End If
            Else
                '** 10月第2月曜 **
                If Weekday(w年月日) = vbMonday Then
                    If ((w日 - 1) \ 7) = 1 Then
                        CAA010_成人_海_敬老_体育の日 = True
                    End If
                End If
            End If
        End If
    End If
    If w月 = 7 Then
        If w年 = 2020 Then  '2020年に限り7月24日        2018/09/01
                '** 24日 **
            If w日 = 24 Then
                CAA010_成人_海_敬老_体育の日 = True
            End If
        End If
        If w年 = 2021 Then  '2021年に限り7月22日    2020/12/01
                '** 23日 **
            If w日 = 23 Then
                CAA010_成人_海_敬老_体育の日 = True
            End If
        End If
    End If
    
End Function

'********************************************
Private Function CAA010_春分秋分日() As Boolean
'********************************************
    CAA010_春分秋分日 = False

    If w月 = 3 Then
        If w日 = Fix(20.8431 + (0.242194 * (w年 - 1980)) - Fix((w年 - 1980) / 4)) Then
            CAA010_春分秋分日 = True
        End If
    End If
    
    If w月 = 9 Then
        If w日 = Fix(23.2488 + (0.242194 * (w年 - 1980)) - Fix((w年 - 1980) / 4)) Then
            CAA010_春分秋分日 = True
        End If
    End If
End Function

