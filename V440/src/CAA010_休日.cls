'********************************************
Sub 計算(p年月日 As Date, p営業日区分 As Integer, Optional p稼働日計算 As Boolean = True) ' 07/01/30 V188
'********************************************
    Dim w年月日 As Date
'
    Call CAA010_祝日設定
'
    休日 = CAA010_休日チェック(p年月日)
'
    If p稼働日計算 Then
        w年月日 = p年月日
        While (CAA010_休日チェック(w年月日))
            If p営業日区分 = 0 Then                 ' 07/01/30 V180
                w年月日 = w年月日 + 1
            Else                                    ' 07/01/30 V180
                w年月日 = w年月日 - 1               ' 07/01/30 V180
            End If                                  ' 07/01/30 V180
        Wend
        次回稼働日 = w年月日
    End If
End Sub

