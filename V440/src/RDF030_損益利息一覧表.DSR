'------------------------------------------------
' GroupFooter3_AfterPrint
'------------------------------------------------
Private Sub GroupFooter3_AfterPrint()
'
    Dim j As Integer
'
    For j = 0 To 1
        GrCnt3(j) = 0
    Risoku3(j) = 0
        ZenMaeRisokuZan3(j) = 0: MaeRisokuZou3(j) = 0: MaeRisokuGen3(j) = 0: TouMaeRisokuZan3(j) = 0
        ZenMiRisokuZou3(j) = 0: MiRisokuZou3(j) = 0: MiRisokuGen3(j) = 0: TouMiRisokuZan3(j) = 0
    SonekiRisoku3(j) = 0: RuiSonekiRisoku3(j) = 0
    Next j
'
End Sub

